  "description": "Twenty CRM app for looot: find the work email of a person and fill the industry and size of a company, as record buttons, workflow actions and AI tools.",
  "license": "MIT",
  "homepage": "https://looot.ai",
  "author": {
    "name": "looot",
    "url": "https://looot.ai"
  },
