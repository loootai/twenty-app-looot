    "react": "19.3.0",
    "react-dom": "19.3.0",
    "twenty-client-sdk": "2.44.0",
    "twenty-sdk": "2.44.0",
    "twenty-ui": "2.44.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "4.3.2",
    "vitest": "4.1.11"
