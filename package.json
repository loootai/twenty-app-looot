    "type": "git",
    "url": "git+https://github.com/loootai/twenty-app-looot.git"
  },
  "bugs": {
    "url": "https://github.com/loootai/twenty-app-looot/issues"
  },
  "keywords": [
    "twenty-app",
    "twenty",
    "twenty-crm",
    "looot",
    "enrichment",
    "email-finder",
    "email-verification",
    "company-enrichment"
  ],
  "engines": {
    "node": "^24.5.0",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.2"
  },
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "twenty": "twenty",
    "lint": "oxlint -c .oxlintrc.json .",
